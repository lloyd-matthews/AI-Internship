OPENAI_API_KEY=

# Pinecone. The index must already exist with dimension 1536 (text-embedding-3-small).
# Set the same names in the Render service Environment tab. Do not commit real values.
PINECONE_API_KEY=
PINECONE_INDEX_NAME=
# Optional. Data-plane host from the index page; skips a control-plane lookup.
PINECONE_INDEX_HOST=
# Optional. Leave blank to use Pinecone's default namespace.
PINECONE_NAMESPACE=
