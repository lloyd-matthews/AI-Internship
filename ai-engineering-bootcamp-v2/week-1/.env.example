OPENAI_API_KEY=

# Pinecone. The index must already exist with dimension 1536 (text-embedding-3-small).
# Set the same names in the Render service Environment tab. Do not commit real values.
PINECONE_API_KEY=
PINECONE_INDEX_NAME=
# Optional. Data-plane host from the index page; skips a control-plane lookup.
PINECONE_INDEX_HOST=
# Optional. Leave blank to use Pinecone's default namespace.
PINECONE_NAMESPACE=

# Optional. POST /ingest chunk window, in characters. Defaults are 800 and 100.
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# Optional. Streamlit rag_ui.py reads this. It is the public API URL, not a secret.
API_BASE_URL=https://ai-internship-24cp.onrender.com
